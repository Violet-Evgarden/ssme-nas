{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEME-NAS NB101 concept response format",
  "description": "Documentation schema for the archived prompt's response format; not an extra field sent to the LLM provider.",
  "type": "object",
  "required": [
    "concepts"
  ],
  "additionalProperties": false,
  "properties": {
    "concepts": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "features",
          "meaning"
        ],
        "additionalProperties": false,
        "properties": {
          "features": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "parent_nodes",
                "child_nodes",
                "node_delta",
                "parent_depth",
                "child_depth",
                "depth_delta",
                "parent_paths",
                "path_delta",
                "parent_branches",
                "parent_merges",
                "parent_conv3",
                "parent_conv1",
                "parent_pool",
                "remaining_conv3",
                "remaining_conv1",
                "remaining_pool",
                "touched_path_coverage",
                "same_path_before",
                "same_path_after",
                "edit_kind",
                "edge_delta",
                "shortest_depth_delta"
              ]
            }
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Also require the union of all concept features to equal the feature catalog, and reject duplicate feature sets regardless of feature order. These cross-item constraints are checked by the concept validator."
}
